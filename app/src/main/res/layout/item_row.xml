<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="6dp">
    <TextView android:id="@+id/rowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textColor="@color/text2" android:textSize="15sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rowList"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" />
</LinearLayout>
