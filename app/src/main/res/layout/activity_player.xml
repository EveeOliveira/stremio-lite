<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black">
    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
        android:layout_height="match_parent" app:show_buffering="when_playing" app:show_subtitle_button="true"
        app:show_shuffle_button="false" app:show_next_button="false" app:show_previous_button="false"
        app:animation_enabled="false" />
    <TextView android:id="@+id/osd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_margin="24dp" android:background="#AA000000" android:padding="10dp" android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
