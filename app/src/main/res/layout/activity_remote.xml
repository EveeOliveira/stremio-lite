<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="64dp" android:paddingEnd="64dp">
    <ImageView android:id="@+id/qr" android:layout_width="220dp" android:layout_height="220dp"
        android:background="@android:color/white" android:contentDescription="QR code do controle" android:padding="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="40dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Controle no celular" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Com o celular no mesmo Wi-Fi, aponte a câmera para o QR code. Ele vira controle e teclado para buscar. Não precisa instalar nada."
            android:textColor="@color/text2" android:textSize="15sp" />
        <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:textSize="16sp" />
        <TextView android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/in_progress" android:textSize="34sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnToggle" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/btnNewCode" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Trocar código" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
