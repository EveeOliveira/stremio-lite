<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="40dp" android:paddingTop="20dp"
        android:paddingEnd="40dp" android:paddingBottom="30dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Conta Stremio" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/accountStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/text2" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnLinkLogin" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Entrar com código (celular)" />
            <TextView android:id="@+id/btnEmailLogin" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Entrar com e-mail" />
            <TextView android:id="@+id/btnLogout" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Sair" />
        </LinearLayout>
        <TextView android:id="@+id/linkInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="18sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/loginForm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
            <EditText android:id="@+id/email" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="@drawable/edit_bg" android:hint="e-mail"
                android:inputType="textEmailAddress" android:padding="10dp" android:singleLine="true"
                android:textColorHint="@color/text2" />
            <EditText android:id="@+id/password" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/edit_bg"
                android:hint="senha" android:inputType="textPassword" android:padding="10dp" android:singleLine="true"
                android:textColorHint="@color/text2" />
            <TextView android:id="@+id/btnDoLogin" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Entrar" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Addons" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Com login, os addons vêm da conta. Os adicionados aqui valem nos dois modos (OK remove)."
            android:textColor="@color/text2" android:textSize="12sp" />
        <LinearLayout android:id="@+id/addonList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <EditText android:id="@+id/addonUrl" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="@drawable/edit_bg"
                android:hint="URL do manifest (https://.../manifest.json)" android:inputType="textUri"
                android:padding="10dp" android:singleLine="true" android:textColorHint="@color/text2" />
            <TextView android:id="@+id/btnAddAddon" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Adicionar" />
        </LinearLayout>
        <TextView android:id="@+id/btnReload" style="@style/Btn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Recarregar addons e biblioteca" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/text2" />
    </LinearLayout>
</ScrollView>
