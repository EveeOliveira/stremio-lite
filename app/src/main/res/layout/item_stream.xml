<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="5dp" android:background="@drawable/row_bg" android:clickable="true"
    android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
    <TextView android:id="@+id/quality" android:layout_width="78dp" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="17sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/desc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:textColor="@color/text2" android:textSize="12sp" />
        <LinearLayout android:id="@+id/badges" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
